    </Method>
    <Method Name="SetSignal" Id="{665d5821-5d96-4799-aa5d-f419e69d82b5}">
      <Declaration><![CDATA[METHOD SetSignal
VAR_INPUT
	inTitle : STRING;
	inSignal : BOOL;
END_VAR

VAR
	_index : INT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR _index := 0 TO 20 DO 
	IF _iconSet[_index].Title = inTitle THEN 
		_iconSet[_index].Signal := inSignal;
		RETURN;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
