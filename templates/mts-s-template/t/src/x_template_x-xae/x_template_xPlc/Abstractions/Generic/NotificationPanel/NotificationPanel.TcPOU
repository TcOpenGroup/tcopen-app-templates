<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="NotificationPanel" Id="{2928ab2f-ea83-0435-171c-b9c0980f8160}" SpecialFunc="None">
    <Declaration><![CDATA[{attribute wpf [Container(Layout.Stack)]}
FUNCTION_BLOCK NotificationPanel EXTENDS TcoObject
VAR_INPUT
	(*~
		<docu>
			<summary>
				Time duration for toggle signal.
			</summary>
		</docu>
	~*)
	inBlinkPeriod:TIME;
END_VAR

VAR
	{attribute addProperty Name "<#Heart beat#>"}
  	_heartBeat : BOOL;
	
    {attribute clr [RenderIgnore()]}
	_badgeValue : INT;

	{attribute clr [RenderIgnore()]}
    _toggle: TcoUtilities.TcoBlinker(THIS^);
	
	_iconSet: ARRAY[0..20] OF Icon; //ak potrebujes zobrazit viac ikon, uprav velkost pola
	
	_iconSetClear : ARRAY[0..20] OF Icon; //ak potrebujes zobrazit viac ikon, uprav velkost pola
	
	_iconPlcPulse : Icon;
	
	_iconParamsClear : Icon;
	
END_VAR
	

]]></Declaration>
    <Implementation>
      <ST><![CDATA[

_iconPlcPulse.Title := '<#PLC connection#>';
_iconPlcPulse.IconType := TO_STRING(eIconType.plcConnection);
_iconPlcPulse.Signal := _heartBeat;
_iconPlcPulse.DisableRedIcon := TRUE;
addIcon(_iconPlcPulse);

//setIconsStyle();

Blink();
CountSignals();







]]></ST>
    </Implementation>
    <Method Name="AddIcon" Id="{2a610e16-906a-49b5-9c35-0302376f96c9}">
      <Declaration><![CDATA[METHOD AddIcon : BOOL
VAR_INPUT
	inIcon : Icon;
END_VAR

VAR 
	_index : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR  _index := 0 TO 20 DO 
	IF _IconSet[_index].Title = '' THEN
		_IconSet[_index] := inIcon;
		RETURN;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="Blink" Id="{d779bc9b-5ccc-4241-baac-18a7b45cc3d3}">
      <Declaration><![CDATA[METHOD Blink
VAR 
	_index : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_toggle(inOffTime:=inBlinkPeriod,inOnTime:=inBlinkPeriod);
_heartBeat := _toggle.IsOn;
	FOR _index := 0 TO 20 DO
		IF _iconSet[_index].BlinkEnabled AND NOT _iconSet[_index].Signal THEN 
			_iconSet[_index].SignalBlink := _toggle.IsOn;		
		ELSE
			_iconSet[_index].SignalBlink := _iconSet[_index].Signal;
		END_IF
	END_FOR

]]></ST>
      </Implementation>
    </Method>
    <Method Name="Clear" Id="{98437acd-3427-45b1-8068-68a3fcbfcb6c}">
      <Declaration><![CDATA[METHOD Clear 
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_iconSet := _iconSetClear;
_badgeValue := 0;]]></ST>
      </Implementation>
    </Method>
    <Method Name="CountSignals" Id="{cb041011-57e9-48eb-8354-3b0ea9b4ed06}">
      <Declaration><![CDATA[METHOD CountSignals
VAR
	_iconIndex : INT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_iconIndex := 0;
_badgeValue := 0;
FOR _iconIndex := 0 TO 20 DO
	IF _iconSet[_iconIndex].Title <> '' AND  NOT _iconSet[_iconIndex].DisableRedIcon THEN 
		_badgeValue := _badgeValue + BOOL_TO_INT(NOT _iconSet[_iconIndex].Signal);
	END_IF
END_FOR
]]></ST>
      </Implementation>
    </Method>
